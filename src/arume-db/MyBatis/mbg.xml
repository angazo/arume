<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE generatorConfiguration PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN" "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd" >
<generatorConfiguration >

    <context id="h2" targetRuntime="MyBatis3">

        <property name="javaFileEncoding" value="UTF-8"/>

        <plugin type="org.mybatis.generator.plugins.SerializablePlugin"/>

        <plugin type="com.softwareloop.mybatis.generator.plugins.LombokPlugin">
            <!-- enable annotations -->
            <property name="builder" value="true"/>
            <!-- annotation's option(boolean) -->
            <property name="builder.fluent" value="true"/>
            <!-- annotation's option(String) -->
            <property name="builder.builderMethodName" value="myBuilder"/>

            <property name="accessors" value="true"/>
            <!-- annotation's option(array of String) -->
            <property name="accessors.prefix" value="m_, _"/>

            <!-- disable annotations -->
            <property name="allArgsConstructor" value="false"/>
        </plugin>

        <commentGenerator>
            <property name="suppressDate" value="true"/>
            <property name="addRemarkComments" value="true"/>
        </commentGenerator>

        <jdbcConnection driverClass="org.h2.Driver"
                        connectionURL="${mbgen.url}"
                        userId="${mbgen.user}"
                        password="${mbgen.password}"/>

        <!-- Use java API time -->
        <javaTypeResolver>
            <property name="useJSR310Types" value="true"/>
        </javaTypeResolver>

        <!-- Target paths -->
        <javaModelGenerator targetPackage="com.angazo.arume.db.persistence.model" targetProject="${projectDir}/src/main/java" />
        <sqlMapGenerator targetPackage="mappers" targetProject="${projectDir}/src/main/resources" />
        <javaClientGenerator type="XMLMAPPER" targetPackage="com.angazo.arume.db.persistence.mapper.generated" targetProject="${projectDir}/src/main/java"/>

        <table schema="public" tableName="t1_countries"
               enableCountByExample="false" enableDeleteByExample="false"
               enableUpdateByExample="false" enableSelectByExample="false"
               modelType="flat">
            <property name="useActualColumnNames" value="false" />
            <property name="customizedNextVersion" value="false"/>
            <property name="versionColumn" value="version"/>
            <property name="enablePrimaryKeyClass" value="false"/>
        </table>
        <table schema="public" tableName="t2_currencies"
               enableCountByExample="false" enableDeleteByExample="false"
               enableUpdateByExample="false" enableSelectByExample="false"
               modelType="flat">
            <property name="useActualColumnNames" value="false" />
            <property name="customizedNextVersion" value="false"/>
            <property name="versionColumn" value="version"/>
            <property name="enablePrimaryKeyClass" value="false"/>
        </table>
        <table schema="public" tableName="t3_country_currency"
               enableCountByExample="false" enableDeleteByExample="false"
               enableUpdateByExample="false" enableSelectByExample="false"
               modelType="flat">
            <property name="useActualColumnNames" value="false" />
            <property name="customizedNextVersion" value="false"/>
            <property name="versionColumn" value="version"/>
            <property name="enablePrimaryKeyClass" value="false"/>
            </table>

        <table schema="public" tableName="t4_companies"
               enableCountByExample="false" enableDeleteByExample="false"
               enableUpdateByExample="false" enableSelectByExample="false"
               modelType="flat">
            <property name="useActualColumnNames" value="false" />
            <property name="customizedNextVersion" value="false"/>
            <property name="versionColumn" value="version"/>
            <property name="enablePrimaryKeyClass" value="false"/>
            <generatedKey column="id" sqlStatement="JDBC" identity="true" />
        </table>
        <table schema="public" tableName="t5_company_profiles"
               enableCountByExample="false" enableDeleteByExample="false"
               enableUpdateByExample="false" enableSelectByExample="false"
               modelType="flat">
            <property name="useActualColumnNames" value="false" />
            <property name="customizedNextVersion" value="false"/>
            <property name="versionColumn" value="version"/>
            <property name="enablePrimaryKeyClass" value="false"/>
            <generatedKey column="id" sqlStatement="JDBC" identity="true" />
        </table>
        <table schema="public" tableName="t6_company_tax_registrations"
               enableCountByExample="false" enableDeleteByExample="false"
               enableUpdateByExample="false" enableSelectByExample="false"
               modelType="flat">
            <property name="useActualColumnNames" value="false" />
            <property name="customizedNextVersion" value="false"/>
            <property name="versionColumn" value="version"/>
            <property name="enablePrimaryKeyClass" value="false"/>
            <generatedKey column="id" sqlStatement="JDBC" identity="true" />
        </table>
        <table schema="public" tableName="t7_fiscal_years"
               enableCountByExample="false" enableDeleteByExample="false"
               enableUpdateByExample="false" enableSelectByExample="false"
               modelType="flat">
            <property name="useActualColumnNames" value="false" />
            <property name="customizedNextVersion" value="false"/>
            <property name="versionColumn" value="version"/>
            <property name="enablePrimaryKeyClass" value="false"/>
            <generatedKey column="id" sqlStatement="JDBC" identity="true" />
        </table>

    </context>

</generatorConfiguration>
